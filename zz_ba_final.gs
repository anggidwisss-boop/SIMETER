/* RIMPU PLN UP3 BIMA - Berita Acara Pemeliharaan Meter */
const BA_HEADERS_FINAL_ = ['ID BA','Timestamp','Tanggal','ID Tugas','ID Pelanggan','Nomor Meter','Nama Pelanggan','Alamat','Petugas','Username','Unit','Jenis Pemeliharaan','Hasil Pemeriksaan','Keterangan','Status','PDF URL'];
function ensureBAFinal_(){const book=ss();let sh=book.getSheetByName('BERITA_ACARA');if(!sh)sh=book.insertSheet('BERITA_ACARA');if(sh.getLastRow()===0)sh.getRange(1,1,1,BA_HEADERS_FINAL_.length).setValues([BA_HEADERS_FINAL_]).setFontWeight('bold');else{const cur=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),BA_HEADERS_FINAL_.length)).getDisplayValues()[0];BA_HEADERS_FINAL_.forEach(function(h,i){if(!String(cur[i]||'').trim())sh.getRange(1,i+1).setValue(h).setFontWeight('bold');});}sh.setFrozenRows(1);return sh;}
function baNextIdFinal_(){const y=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy');const sh=ensureBAFinal_(),rows=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,1).getDisplayValues().flat():[],prefix='BA/UP3-BIMA/PM/'+y+'/',max=0;rows.forEach(function(x){const s=String(x||'');if(s.indexOf(prefix)===0){const n=Number(s.slice(prefix.length));if(Number.isFinite(n))max=Math.max(max,n);}});return prefix+String(max+1).padStart(4,'0');}
function saveBeritaAcara(d){const sh=ensureBAFinal_(),m=(findMeter(d.nomorMeter||'')||{}).meter||{},now=new Date(),date=d.tanggal||Utilities.formatDate(now,Session.getScriptTimeZone(),'yyyy-MM-dd'),id=baNextIdFinal_();const row=[id,now,date,d.idTugas||'',d.idPelanggan||m.idPelanggan||'',d.nomorMeter||'',d.namaPelanggan||m.namaPelanggan||'',d.alamat||m.alamat||'',d.petugas||'',d.username||'',d.unit||'UP3 Bima',d.jenis||'Pemeliharaan meter',d.hasil||'Selesai / Normal',d.keterangan||'',d.status||'DRAFT',''];sh.getRange(sh.getLastRow()+1,1,1,row.length).setValues([row]);return {ok:true,idBA:id,message:'Berita Acara tersimpan'};}
function getBeritaAcara(idBA){const sh=ensureBAFinal_();if(sh.getLastRow()<2)return {ok:true,data:null};const rows=sh.getDataRange().getDisplayValues();for(let i=1;i<rows.length;i++)if(String(rows[i][0])===String(idBA||''))return {ok:true,data:{idBA:rows[i][0],tanggal:rows[i][2],idTugas:rows[i][3],idPelanggan:rows[i][4],nomorMeter:rows[i][5],namaPelanggan:rows[i][6],alamat:rows[i][7],petugas:rows[i][8],username:rows[i][9],unit:rows[i][10],jenis:rows[i][11],hasil:rows[i][12],keterangan:rows[i][13],status:rows[i][14],pdfUrl:rows[i][15]}};return {ok:false,error:'Berita Acara tidak ditemukan'};}
function getBeritaAcaraByTask(idTugas){const sh=ensureBAFinal_();if(sh.getLastRow()<2)return {ok:true,data:null};const rows=sh.getDataRange().getDisplayValues();for(let i=1;i<rows.length;i++)if(String(rows[i][3])===String(idTugas||''))return {ok:true,data:{idBA:rows[i][0],pdfUrl:rows[i][15],status:rows[i][14]}};return {ok:true,data:null};}
function signBeritaAcara(d){const sh=ensureBAFinal_(),id=String(d.idBA||'').trim();if(!id)return {ok:false,error:'ID BA wajib'};const rows=sh.getDataRange().getDisplayValues();for(let i=1;i<rows.length;i++)if(String(rows[i][0])===id){sh.getRange(i+1,15).setValue('DITANDATANGANI');return {ok:true,message:'Status BA diperbarui'};}return {ok:false,error:'Berita Acara tidak ditemukan'};}
function createBAPdf(idBA){const info=getBeritaAcara(idBA);if(!info.ok)return info;const d=info.data,folder=DriveApp.getFolderById(FOLDER_ID),doc=DocumentApp.create('BA - '+d.idBA+' - '+d.nomorMeter),file=DriveApp.getFileById(doc.getId());try{file.moveTo(folder);}catch(_){}const body=doc.getBody();body.clear();body.setMarginTop(36).setMarginBottom(36).setMarginLeft(45).setMarginRight(45);try{const img=UrlFetchApp.fetch('https://commons.wikimedia.org/wiki/Special:Redirect/file/Logo_PLN.png',{muteHttpExceptions:true}).getBlob();body.appendImage(img).setWidth(90);}catch(_){body.appendParagraph('PLN').setBold(true).setFontSize(20);}const h=body.appendParagraph('PT PLN (Persero)');h.setBold(true).setFontSize(13).setForegroundColor('#063B78');const u=body.appendParagraph('UP3 BIMA\nUNIT PELAKSANA PELAYANAN PELANGGAN BIMA');u.setBold(true).setFontSize(10);body.appendHorizontalRule();const title=body.appendParagraph('BERITA ACARA PEMELIHARAAN METER');title.setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true).setFontSize(14).setForegroundColor('#063B78');const no=body.appendParagraph('Nomor: '+d.idBA);no.setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true).setFontSize(10);body.appendParagraph('Pada hari ini telah dilaksanakan pemeriksaan/pemeliharaan meter pelanggan dengan data sebagai berikut:').setFontSize(10);const data=[['ID Pelanggan',d.idPelanggan||'-'],['Nomor Meter',d.nomorMeter||'-'],['Nama Pelanggan',d.namaPelanggan||'-'],['Alamat',d.alamat||'-'],['Petugas',d.petugas||'-'],['Unit',d.unit||'UP3 Bima'],['Jenis Pemeliharaan',d.jenis||'-'],['Hasil Pemeriksaan',d.hasil||'-'],['Keterangan',d.keterangan||'-']];const table=body.appendTable(data);table.setBorderWidth(0.5);for(let r=0;r<table.getNumRows();r++){table.getCell(r,0).setBackgroundColor('#EEF4FA');table.getCell(r,0).getChild(0).asParagraph().setBold(true);}body.appendParagraph('Demikian Berita Acara ini dibuat dengan sebenarnya untuk dapat dipergunakan sebagaimana mestinya.').setSpacingBefore(12).setFontSize(10);body.appendParagraph('Bima, '+Utilities.formatDate(new Date(d.tanggal||new Date()),Session.getScriptTimeZone(),'dd MMMM yyyy')).setAlignment(DocumentApp.HorizontalAlignment.RIGHT).setFontSize(10);const sig=body.appendTable([['Petugas Pelaksana','Mengetahui / Perwakilan Pelanggan'],['\n\n\n( '+(d.petugas||'________________')+' )','\n\n\n( __________________ )'],['NIP: __________________','Nama: __________________']]);sig.setBorderWidth(0);for(let r=0;r<sig.getNumRows();r++)for(let c=0;c<sig.getRow(r).getNumCells();c++)sig.getCell(r,c).getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER).setFontSize(9);body.appendParagraph('RIMPU PLN UP3 Bima · Sistem digital pemeliharaan meter transaksi energi').setFontSize(8).setForegroundColor('#6B7280').setAlignment(DocumentApp.HorizontalAlignment.CENTER).setSpacingBefore(18);doc.saveAndClose();const pdf=folder.createFile(file.getAs(MimeType.PDF)).setName('BA-'+d.idBA.replace(/\//g,'-')+'.pdf');let shareUrl='';try{pdf.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);shareUrl='https://drive.google.com/uc?export=download&id='+pdf.getId();}catch(_){shareUrl=pdf.getUrl();}const sh=ensureBAFinal_(),rows=sh.getDataRange().getDisplayValues();for(let i=1;i<rows.length;i++)if(String(rows[i][0])===String(idBA)){sh.getRange(i+1,15).setValue('TERSEDIA');sh.getRange(i+1,16).setValue(shareUrl);break;}try{file.setTrashed(true);}catch(_){}return {ok:true,idBA:idBA,url:pdf.getUrl(),downloadUrl:shareUrl,message:'PDF Berita Acara berhasil dibuat'};}
